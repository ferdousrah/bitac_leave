# Copy this file to .env and fill in real values.
# Coolify: paste these as Environment Variables in the app's settings.

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=bitac
DB_PASSWORD=change-me-strong-password
DB_NAME=bitac_leave
DB_ROOT_PASSWORD=change-me-root-password

# ── App URL ─────────────────────────────────────────────────────────────
# Full URL (no trailing slash) where the app is reachable.
# Examples:
#   https://leave.example.com
#   http://leave.local:8080
APP_BASE_URL=https://bitac.yourdomain.com
APP_PROTOCOL=https

# ── Old BITAC system (pre-cutover leave totals) ──────────────────────────
# URL of legacy-api/leave-totals.php inside the old system, reachable from
# this container (an internal Docker/Coolify network name is best), and the
# token set as LEGACY_API_TOKEN on the old system. Leave empty until cutover;
# the sync page then says it is not configured and nothing changes.
LEGACY_API_URL=http://bitac-old/legacy-api/leave-totals.php
LEGACY_API_TOKEN=

# ── Local docker-compose port mapping (only matters for local docker compose) ──
APP_PORT=8080
