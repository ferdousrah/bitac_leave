# Copy this file to .env and fill in real values.
# Coolify: paste these as Environment Variables in the app's settings.

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=bitac
DB_PASSWORD=change-me-strong-password
DB_NAME=bitac_leave
DB_ROOT_PASSWORD=change-me-root-password

# ── App URL ─────────────────────────────────────────────────────────────
# Full URL (no trailing slash) where the app is reachable.
# Examples:
#   https://leave.example.com
#   http://leave.local:8080
APP_BASE_URL=https://bitac.yourdomain.com
APP_PROTOCOL=https

# ── Local docker-compose port mapping (only matters for local docker compose) ──
APP_PORT=8080
